}
function addLog(id){
  const i=document.getElementById("li"+id);const tx=i.value.trim();if(!tx)return;
  const t=TASKS.find(x=>x.id===id);if(!t)return;
  const now=new Date().toLocaleString("es-CL",{year:"numeric",month:"2-digit",day:"2-digit",hour:"2-digit",minute:"2-digit"}).replace(","," ");
  t.log.push({t:now,ic:"📝",tx});i.value="";renderTasks();
  setTimeout(()=>{const b=document.getElementById("bit"+id),e=document.getElementById("eb"+id);if(b&&!b.classList.contains("open")){b.classList.add("open");e.classList.add("open");}},40);
}

// ─── PROJECTS ───
let PROJS=[
  {name:"pc.valy · Infraestructura IA",desc:"Servidor personal HP 820 con OpenClaw, Telegram bot y acceso remoto. Expansión con Tailscale, Ollama y Claude Code.",status:"progress"},
  {name:"Agente Pelusa",desc:"Agente exploradora de modelos free (ex-Ranger). Groq llama-3.3-70b como principal con fallbacks Gemini 2.5, Qwen 32b y Compound.",status:"progress"},
  {name:"Documentos Ambientales IA",desc:"Sistema de consulta de PDFs por subproyectos. RAG sobre documentación. Agente Valy como motor de consulta.",status:"plan"},
  {name:"Integración Google Suite",desc:"Maton.ai conectado con Gmail, Calendar, Drive y Docs. Gestión de documentos y eventos vía agente.",status:"done"},
  {name:"Integración Gemini API",desc:"Gemini 2.5 Flash configurado en fallbacks de Pelusa. Tier gratuito activo.",status:"done"},
];
const SLBL={done:"✓ Completado",progress:"▶ En Curso",plan:"◎ Planificación"};
const SCLS={done:"b-ok",progress:"b-info",plan:"b-pend"};
function renderProjs(){
  const g=document.getElementById("projGrid");g.innerHTML="";
  PROJS.forEach((p,i)=>{
    const d=document.createElement("div");
    d.className="proj-card "+p.status;
    d.innerHTML=`<div class="proj-name">${p.name}</div><div class="proj-desc">${p.desc}</div>
      <div class="proj-foot">
        <span class="badge ${SCLS[p.status]}">${SLBL[p.status]}</span>
        <button class="del-proj" onclick="delProj(${i})">✕</button>
      </div>`;
    g.appendChild(d);
  });
}
function delProj(i){PROJS.splice(i,1);renderProjs();}
function addProject(){
  const n=document.getElementById("pName").value.trim();
  const d=document.getElementById("pDesc").value.trim();
  const s=document.getElementById("pStatus").value;
  if(!n)return;
  PROJS.unshift({name:n,desc:d||"Sin descripción.",status:s});
  document.getElementById("pName").value="";
  document.getElementById("pDesc").value="";
  renderProjs();
}

