<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>Valy IA · Command Center</title>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;600;700&display=swap" rel="stylesheet"/>
<style>
:root{
  --bg:#050d1a;--bg2:#071426;--surf:#0b1e38;--surf2:#0f2847;--surf3:#152f54;
  --bdr:rgba(63,147,255,.18);--bdr2:rgba(63,147,255,.34);
  --blue:#3f93ff;--blue2:#5eaaff;--cyan:#38e8ff;
  --green:#22d08a;--red:#ff5575;--yellow:#f9c75b;--orange:#ff8c42;--purple:#a78bfa;
  --txt:#eaf4ff;--muted:#7a9ec0;--muted2:#2a4060;
  --shadow:0 24px 64px rgba(0,0,0,.44);--r:16px;
  --mono:'JetBrains Mono',monospace;--sans:'Inter',system-ui,sans-serif;
  --grad:linear-gradient(135deg,var(--blue),var(--cyan));
}
body.light{
  --bg:#e8f3ff;--bg2:#ddeeff;--surf:#fff;--surf2:#eef6ff;--surf3:#deeeff;
  --bdr:rgba(42,110,209,.18);--bdr2:rgba(42,110,209,.38);
  --blue:#1a6dd4;--blue2:#2b8cff;--cyan:#0093b8;
  --green:#0d9e6a;--red:#d93050;--yellow:#c07800;--orange:#c05800;--purple:#7c3aed;
  --txt:#071527;--muted:#5a7a9a;--muted2:#c0d8f0;
  --shadow:0 18px 48px rgba(20,70,130,.12);
}
*{box-sizing:border-box;margin:0;padding:0;}
html{scroll-behavior:smooth;}
body{font-family:var(--sans);background:var(--bg);color:var(--txt);min-height:100vh;overflow-x:hidden;transition:background .3s,color .3s;}
body::before{
  content:"";position:fixed;inset:0;pointer-events:none;z-index:0;
  background-image:linear-gradient(rgba(63,147,255,.05) 1px,transparent 1px),linear-gradient(90deg,rgba(63,147,255,.05) 1px,transparent 1px);
  background-size:48px 48px;mask-image:linear-gradient(to bottom,#000 0%,transparent 75%);
}
body::after{
  content:"";position:fixed;inset:0;pointer-events:none;z-index:0;
  background:radial-gradient(ellipse 55% 35% at 18% -5%,rgba(63,147,255,.22),transparent),
             radial-gradient(ellipse 38% 28% at 88% 4%,rgba(56,232,255,.13),transparent);
}
.app{display:grid;grid-template-columns:268px 1fr;min-height:100vh;position:relative;z-index:1;}

/* SIDEBAR */
.sidebar{
  position:sticky;top:0;height:100vh;
  background:linear-gradient(180deg,rgba(11,30,56,.98),rgba(5,13,26,.98));
  border-right:1px solid var(--bdr);
  display:flex;flex-direction:column;overflow:hidden;
}
body.light .sidebar{background:linear-gradient(180deg,rgba(255,255,255,.97),rgba(230,245,255,.97));}
.brand{padding:20px 18px 16px;display:flex;align-items:center;gap:13px;border-bottom:1px solid var(--bdr);}
.brand-logo{
  width:56px;height:56px;flex-shrink:0;border-radius:50%;
  background:rgba(63,147,255,.08);border:1.5px solid var(--bdr2);
  display:flex;align-items:center;justify-content:center;overflow:hidden;
  box-shadow:0 0 22px rgba(63,147,255,.2);
}
.brand-logo img{width:100%;height:100%;object-fit:cover;}
.brand-name{font-size:1.38rem;font-weight:800;letter-spacing:-.01em;line-height:1;}
.brand-name span{background:var(--grad);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;}
.brand-sub{margin-top:4px;font-size:.67rem;font-family:var(--mono);color:var(--muted);letter-spacing:.05em;}
.nav{flex:1;padding:14px 10px;display:flex;flex-direction:column;gap:3px;overflow-y:auto;}
.nav-item{
  display:flex;align-items:center;gap:11px;padding:10px 13px;border-radius:11px;
  cursor:pointer;user-select:none;color:var(--muted);font-weight:550;font-size:.87rem;
  transition:.18s;border:1px solid transparent;
}
.nav-item:hover{color:var(--txt);background:rgba(63,147,255,.07);}
.nav-item.active{color:var(--txt);background:linear-gradient(135deg,rgba(63,147,255,.2),rgba(56,232,255,.05));border-color:var(--bdr);box-shadow:inset 3px 0 0 var(--blue);}
.nav-icon{font-size:1rem;width:20px;text-align:center;}
.nbadge{margin-left:auto;min-width:19px;height:19px;background:var(--orange);color:#fff;border-radius:9px;font-size:.6rem;font-weight:700;display:flex;align-items:center;justify-content:center;padding:0 4px;}
.nbadge.ok{background:var(--green);}
.nbadge.info{background:var(--blue);}
.nsep{height:1px;background:var(--bdr);margin:7px 3px;}
.side-status{
  margin:10px;padding:13px;border-radius:13px;
  background:linear-gradient(135deg,rgba(34,208,138,.1),rgba(56,232,255,.05));
  border:1px solid rgba(34,208,138,.2);
}
.ss-row{display:flex;align-items:center;gap:8px;margin-bottom:5px;}
.dot{width:7px;height:7px;border-radius:50%;background:var(--green);box-shadow:0 0 9px var(--green);animation:pulse 2.4s infinite;}
.dot.warn{background:var(--yellow);box-shadow:0 0 9px var(--yellow);}
.dot.off{background:var(--muted2);box-shadow:none;animation:none;}
@keyframes pulse{0%,100%{opacity:1}50%{opacity:.45}}
.ss-label{font-size:.75rem;font-weight:700;color:var(--green);}
.ss-detail{font-size:.67rem;color:var(--muted);font-family:var(--mono);}
.sidebar-foot{padding:12px 15px;border-top:1px solid var(--bdr);font-size:.68rem;color:var(--muted);font-family:var(--mono);}

/* MAIN */
.main{min-width:0;display:flex;flex-direction:column;}
.topbar{
  height:68px;display:flex;align-items:center;justify-content:space-between;padding:0 26px;
  background:rgba(5,13,26,.76);backdrop-filter:blur(20px);
  border-bottom:1px solid var(--bdr);position:sticky;top:0;z-index:50;
  transition:background .3s;
}
body.light .topbar{background:rgba(255,255,255,.82);}
.page-title{font-size:1.08rem;font-weight:700;letter-spacing:-.01em;}
.page-sub{font-size:.77rem;color:var(--muted);margin-top:2px;}
.topbar-r{display:flex;align-items:center;gap:9px;}
.agent-pill{display:flex;align-items:center;gap:7px;padding:7px 13px;border-radius:99px;background:rgba(34,208,138,.09);border:1px solid rgba(34,208,138,.22);font-size:.77rem;font-weight:600;color:var(--green);}
.icon-btn{width:39px;height:39px;border-radius:11px;background:rgba(63,147,255,.07);border:1px solid var(--bdr);color:var(--txt);cursor:pointer;display:grid;place-items:center;font-size:1rem;transition:.18s;}
.icon-btn:hover{border-color:var(--blue2);transform:translateY(-1px);}

.content{padding:22px 26px 40px;flex:1;}
.section{display:none;animation:fadeUp .22s ease;}
.section.active{display:block;}
@keyframes fadeUp{from{opacity:0;transform:translateY(7px);}to{opacity:1;transform:none;}}

/* HERO */
.hero{border:1px solid var(--bdr);border-radius:var(--r);padding:22px;margin-bottom:18px;background:linear-gradient(135deg,rgba(11,30,56,.92),rgba(11,30,56,.5));position:relative;overflow:hidden;box-shadow:var(--shadow);}
body.light .hero{background:linear-gradient(135deg,#fff,#eef6ff);}
.hero-deco{position:absolute;right:-10px;top:0;bottom:0;width:260px;opacity:.1;background:repeating-linear-gradient(45deg,var(--blue) 0,var(--blue) 1px,transparent 1px,transparent 20px);pointer-events:none;}
.hero-inner{position:relative;z-index:1;}
.hero h2{font-size:1.28rem;font-weight:800;margin-bottom:7px;}
.hero p{color:var(--muted);line-height:1.62;max-width:660px;font-size:.88rem;}
.tags{display:flex;flex-wrap:wrap;gap:6px;margin-top:13px;}
.tag{padding:4px 10px;border-radius:99px;font-size:.67rem;font-weight:700;letter-spacing:.04em;border:1px solid;}
.t-blue{color:var(--blue2);border-color:rgba(63,147,255,.3);background:rgba(63,147,255,.08);}
.t-green{color:var(--green);border-color:rgba(34,208,138,.3);background:rgba(34,208,138,.07);}
.t-cyan{color:var(--cyan);border-color:rgba(56,232,255,.28);background:rgba(56,232,255,.07);}
.t-yellow{color:var(--yellow);border-color:rgba(249,199,91,.28);background:rgba(249,199,91,.07);}
.t-orange{color:var(--orange);border-color:rgba(255,140,66,.28);background:rgba(255,140,66,.07);}
.t-red{color:var(--red);border-color:rgba(255,85,117,.28);background:rgba(255,85,117,.07);}
.t-purple{color:var(--purple);border-color:rgba(167,139,250,.28);background:rgba(167,139,250,.07);}

/* KPI ROW */
.krow{display:grid;grid-template-columns:repeat(4,1fr);gap:13px;margin-bottom:18px;}
@media(max-width:860px){.krow{grid-template-columns:repeat(2,1fr);}}
.kpi{background:linear-gradient(145deg,var(--surf),var(--surf2));border:1px solid var(--bdr);border-radius:var(--r);padding:16px;position:relative;overflow:hidden;transition:.2s;box-shadow:0 4px 18px rgba(0,0,0,.16);}
.kpi:hover{border-color:var(--bdr2);transform:translateY(-2px);}
.kpi::before{content:"";position:absolute;top:0;left:0;right:0;height:2.5px;background:var(--grad);}
.kpi-icon{width:38px;height:38px;border-radius:11px;background:rgba(63,147,255,.1);border:1px solid var(--bdr);display:grid;place-items:center;font-size:1.05rem;margin-bottom:12px;}
.kpi-lbl{font-size:.68rem;font-weight:700;text-transform:uppercase;letter-spacing:.1em;color:var(--muted);}
.kpi-val{font-size:1.95rem;font-weight:800;margin-top:4px;letter-spacing:-.04em;}
.kpi-hint{font-size:.73rem;color:var(--muted);margin-top:4px;}
.c-green{color:var(--green)!important}.c-yellow{color:var(--yellow)!important}.c-red{color:var(--red)!important}
.c-blue{color:var(--blue2)!important}.c-orange{color:var(--orange)!important}.c-cyan{color:var(--cyan)!important}.c-purple{color:var(--purple)!important}

/* CARD */
.card{background:linear-gradient(145deg,var(--surf),var(--surf2));border:1px solid var(--bdr);border-radius:var(--r);box-shadow:0 4px 18px rgba(0,0,0,.13);overflow:hidden;transition:border-color .2s;}
.card:hover{border-color:var(--bdr2);}
.ch{padding:14px 18px;border-bottom:1px solid var(--bdr);display:flex;align-items:center;justify-content:space-between;}
.ct{font-weight:700;font-size:.9rem;display:flex;align-items:center;gap:7px;}
.cb{padding:16px 18px;}
.g2{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-bottom:14px;}
.g3{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-bottom:14px;}
.g4{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-bottom:14px;}
@media(max-width:760px){.g2,.g3,.g4{grid-template-columns:1fr;}}
.mb14{margin-bottom:14px;}

/* SECTION HEADER */
.sch{display:flex;align-items:center;justify-content:space-between;margin-bottom:13px;}
.stitle{font-size:.77rem;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:var(--muted);display:flex;align-items:center;gap:7px;}
.stitle::before{content:"";width:3px;height:13px;background:var(--grad);border-radius:2px;}

/* AGENT CARD */
.ac{display:flex;align-items:flex-start;gap:13px;padding:15px;border-radius:var(--r);border:1px solid var(--bdr);background:linear-gradient(135deg,var(--surf2),var(--surf3));transition:.2s;position:relative;overflow:hidden;}
.ac::before{content:"";position:absolute;inset:0 0 auto;height:2px;background:var(--grad);}
.ac:hover{border-color:var(--bdr2);}
.ac.offline::before{background:linear-gradient(135deg,var(--muted2),var(--muted));}
.ac.exp::before{background:linear-gradient(135deg,var(--orange),var(--yellow));}
.ac.goog::before{background:linear-gradient(135deg,#4285f4,#ea4335);}
.a-ava{width:50px;height:50px;flex-shrink:0;border-radius:14px;background:rgba(63,147,255,.1);border:1.5px solid var(--bdr);display:flex;align-items:center;justify-content:center;font-size:1.5rem;}
.a-name{font-weight:800;font-size:1.02rem;}
.a-model{font-family:var(--mono);font-size:.64rem;color:var(--muted);margin-top:3px;}
.a-status{display:flex;align-items:center;gap:6px;font-size:.71rem;font-weight:600;margin-top:7px;}
.a-status.on{color:var(--green);}
.a-status.dev{color:var(--yellow);}
.a-status.goo{color:#4285f4;}
.a-meta{margin-top:6px;font-size:.71rem;color:var(--muted);font-family:var(--mono);}

/* SYS ITEMS */
.sys-row{display:flex;flex-direction:column;gap:7px;}
.si{display:flex;align-items:center;gap:9px;padding:9px 12px;border-radius:9px;background:rgba(63,147,255,.03);border:1px solid var(--bdr);font-size:.79rem;transition:.15s;}
.si:hover{background:rgba(63,147,255,.07);}
.si-icon{font-size:.95rem;width:20px;text-align:center;}
.si-lbl{flex:1;font-weight:500;}
.si-val{font-family:var(--mono);font-size:.7rem;color:var(--blue2);}
.badge{font-size:.62rem;font-weight:700;letter-spacing:.05em;padding:2px 7px;border-radius:99px;margin-left:6px;}
.b-ok{background:rgba(34,208,138,.1);color:var(--green);border:1px solid rgba(34,208,138,.22);}
.b-warn{background:rgba(249,199,91,.08);color:var(--yellow);border:1px solid rgba(249,199,91,.2);}
.b-err{background:rgba(255,85,117,.1);color:var(--red);border:1px solid rgba(255,85,117,.2);}
.b-pend{background:rgba(63,147,255,.1);color:var(--blue2);border:1px solid rgba(63,147,255,.2);}
.b-info{background:rgba(167,139,250,.1);color:var(--purple);border:1px solid rgba(167,139,250,.2);}

/* INTEGRATION GRID */
.int-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;}
@media(max-width:700px){.int-grid{grid-template-columns:repeat(2,1fr);}}
.int-item{display:flex;align-items:center;gap:8px;padding:9px 11px;border-radius:10px;border:1px solid var(--bdr);background:rgba(63,147,255,.03);font-size:.78rem;transition:.15s;}
.int-item:hover{background:rgba(63,147,255,.07);}
.int-icon{font-size:1.1rem;}
.int-name{font-weight:600;flex:1;}
.int-ok{font-size:.62rem;color:var(--green);font-weight:700;}

/* SPEC TABLE */
.st{width:100%;border-collapse:collapse;}
.st tr{border-bottom:1px solid var(--bdr);}
.st tr:last-child{border-bottom:none;}
.st td{padding:8px 11px;font-size:.79rem;}
.st td:first-child{color:var(--muted);font-weight:600;font-size:.73rem;width:115px;font-family:var(--mono);}

/* TASKS */
.task-section{display:flex;flex-direction:column;gap:7px;}
.task-block{}
.task-item{
  display:flex;align-items:flex-start;gap:11px;padding:11px 15px;
  background:var(--surf);border:1px solid var(--bdr);border-radius:11px;
  cursor:pointer;transition:.18s;user-select:none;
}
.task-item:hover{border-color:var(--bdr2);background:var(--surf2);}
.task-check{flex-shrink:0;width:17px;height:17px;margin-top:2px;border-radius:5px;border:1.5px solid var(--muted2);appearance:none;cursor:pointer;position:relative;transition:.15s;}
.task-check:checked{background:var(--green);border-color:var(--green);}
.task-check:checked::after{content:"✓";position:absolute;top:-2px;left:2px;font-size:10px;color:#fff;font-weight:700;}
.task-main{flex:1;min-width:0;}
.task-name{font-weight:600;font-size:.86rem;line-height:1.3;}
.task-name.done-txt{text-decoration:line-through;color:var(--muted);}
.task-meta{display:flex;align-items:center;gap:6px;margin-top:5px;flex-wrap:wrap;}
.pri{font-size:.62rem;font-weight:700;letter-spacing:.05em;padding:2px 7px;border-radius:99px;}
.p-alta{background:rgba(255,85,117,.1);color:var(--red);border:1px solid rgba(255,85,117,.2);}
.p-media{background:rgba(249,199,91,.08);color:var(--yellow);border:1px solid rgba(249,199,91,.18);}
.p-baja{background:rgba(34,208,138,.07);color:var(--green);border:1px solid rgba(34,208,138,.17);}
.task-date{font-size:.66rem;color:var(--muted);font-family:var(--mono);}
.exp-btn{flex-shrink:0;width:25px;height:25px;border-radius:7px;background:rgba(63,147,255,.07);border:1px solid var(--bdr);display:flex;align-items:center;justify-content:center;font-size:.7rem;color:var(--muted);transition:.2s;cursor:pointer;margin-top:1px;}
.exp-btn.open{background:rgba(63,147,255,.16);border-color:var(--blue);color:var(--blue2);transform:rotate(180deg);}

/* BITÁCORA */
.bitacora{display:none;margin-top:0;border:1px solid var(--bdr);border-top:none;border-radius:0 0 11px 11px;background:rgba(63,147,255,.025);overflow:hidden;}
.bitacora.open{display:block;animation:slideDown .2s ease;}
@keyframes slideDown{from{opacity:0;transform:translateY(-5px);}to{opacity:1;transform:none;}}
.bit-head{padding:7px 13px;background:rgba(63,147,255,.06);border-bottom:1px solid var(--bdr);font-size:.66rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--muted);display:flex;align-items:center;gap:5px;}
.log-e{display:flex;gap:11px;padding:9px 13px;border-bottom:1px solid rgba(63,147,255,.05);font-size:.77rem;}
.log-e:last-child{border-bottom:none;}
.log-t{font-family:var(--mono);color:var(--muted);font-size:.66rem;flex-shrink:0;margin-top:1px;white-space:nowrap;}
.log-ico{flex-shrink:0;font-size:.88rem;}
.log-txt{line-height:1.5;color:var(--txt);}
.log-txt .mono{font-family:var(--mono);font-size:.71rem;color:var(--blue2);background:rgba(63,147,255,.07);padding:1px 4px;border-radius:3px;}
.bit-add{padding:9px 13px;display:flex;gap:7px;}

/* ADD TASK */
.atf{display:flex;gap:7px;margin-bottom:15px;flex-wrap:wrap;}
.inp{flex:1;min-width:140px;padding:9px 13px;border-radius:10px;background:var(--surf);border:1px solid var(--bdr);color:var(--txt);font-family:var(--sans);font-size:.81rem;outline:none;transition:.18s;}
.inp:focus{border-color:var(--blue);}
.inp::placeholder{color:var(--muted);}
select.inp{min-width:95px;max-width:120px;cursor:pointer;}
.btn{padding:9px 16px;border-radius:10px;background:var(--blue);border:none;color:#fff;font-family:var(--sans);font-size:.81rem;font-weight:700;cursor:pointer;transition:.18s;white-space:nowrap;}
.btn:hover{opacity:.85;transform:translateY(-1px);}
.btn-sm{padding:5px 11px;font-size:.73rem;}
.btn-ghost{background:rgba(63,147,255,.1);color:var(--blue2);}

/* PROJECTS */
.proj-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(270px,1fr));gap:11px;}
.proj-card{background:var(--surf);border:1px solid var(--bdr);border-radius:var(--r);padding:15px;transition:.2s;position:relative;overflow:hidden;}
.proj-card::before{content:"";position:absolute;left:0;top:0;bottom:0;width:3px;}
.proj-card.done::before{background:var(--green);}
.proj-card.progress::before{background:var(--blue);}
.proj-card.plan::before{background:var(--muted);}
.proj-card:hover{border-color:var(--bdr2);}
.proj-name{font-weight:700;font-size:.9rem;margin-bottom:6px;}
.proj-desc{font-size:.78rem;color:var(--muted);line-height:1.55;}
.proj-foot{margin-top:10px;display:flex;align-items:center;gap:7px;}
.del-proj{margin-left:auto;background:none;border:none;color:var(--muted);cursor:pointer;font-size:.75rem;padding:2px 5px;border-radius:4px;transition:.15s;}
.del-proj:hover{color:var(--red);}

/* API COSTS */
.cost-krow{display:grid;grid-template-columns:repeat(4,1fr);gap:11px;margin-bottom:16px;}
@media(max-width:860px){.cost-krow{grid-template-columns:repeat(2,1fr);}}
.ck{background:linear-gradient(145deg,var(--surf),var(--surf2));border:1px solid var(--bdr);border-radius:var(--r);padding:15px;}
.ck-lbl{font-size:.68rem;font-weight:700;text-transform:uppercase;letter-spacing:.1em;color:var(--muted);}
.ck-val{font-size:1.75rem;font-weight:800;margin-top:5px;}
.ck-sub{font-size:.72rem;color:var(--muted);margin-top:4px;}
.bar-wrap{margin-top:10px;}
.bar-lbl{display:flex;justify-content:space-between;font-size:.66rem;color:var(--muted);margin-bottom:4px;}
.bar-track{height:6px;background:var(--muted2);border-radius:3px;overflow:hidden;}
.bar-fill{height:100%;background:var(--grad);border-radius:3px;transition:width .5s;}

/* MODEL RANKING */
.rank-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(290px,1fr));gap:9px;}
.rank-card{background:var(--surf);border:1px solid var(--bdr);border-radius:12px;padding:13px;transition:.15s;}
.rank-card:hover{border-color:var(--bdr2);}
.rank-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:8px;}
.rank-name{font-weight:700;font-size:.84rem;}
.rank-pts{font-family:var(--mono);font-size:.7rem;font-weight:700;}
.rank-pts.top{color:var(--green);}
.rank-pts.mid{color:var(--blue2);}
.rank-pts.low{color:var(--muted);}
.rank-scores{display:flex;gap:5px;flex-wrap:wrap;margin-bottom:7px;}
