          </div>
        </div>
      </div>
    </div>

    <!-- ══════ TASKS ══════ -->
    <div class="section" id="s-tasks">
      <div class="atf">
        <input class="inp" type="text" id="newTask" placeholder="Nueva tarea..." onkeydown="if(event.key==='Enter')addTask()"/>
        <select class="inp" id="newPri">
          <option value="alta">🔴 Alta</option>
          <option value="media" selected>🟡 Media</option>
          <option value="baja">🟢 Baja</option>
        </select>
        <button class="btn" onclick="addTask()">+ Agregar</button>
      </div>
