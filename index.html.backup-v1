        <input class="inp" type="text" id="ef-balance" placeholder="Balance disponible (USD)" style="max-width:190px;"/>
        <input class="inp" type="text" id="ef-monthly" placeholder="Gasto mensual (USD)" style="max-width:175px;"/>
        <input class="inp" type="text" id="ef-tokens" placeholder="Tokens consumidos (M)" style="max-width:175px;"/>
        <input class="inp" type="text" id="ef-requests" placeholder="API Requests" style="max-width:145px;"/>
