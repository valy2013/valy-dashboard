    <span id="clock"></span>
  </div>
</main>
</div>

<script>
// ─── NAV ───
const PAGES={
  overview:{t:"Overview",s:"Ecosistema Valy IA · Estado general"},
  agents:{t:"Agentes IA",s:"Valy · Ranger · Maton.ai"},
  infra:{t:"Infraestructura",s:"pc.valy · ZBook · Integraciones"},
  tasks:{t:"Tareas",s:"Gestión de pendientes con bitácora expandible"},
  projects:{t:"Proyectos",s:"Iniciativas del ecosistema Valy IA"},
  api:{t:"API & Modelos",s:"Costos DeepSeek · Ranking Top 15"},
  security:{t:"Seguridad",s:"APIs · Tokens · Buenas prácticas"},
};
function nav(id,el){
  document.querySelectorAll(".section").forEach(s=>s.classList.remove("active"));
  document.querySelectorAll(".nav-item").forEach(n=>n.classList.remove("active"));
  document.getElementById("s-"+id).classList.add("active");
  el.classList.add("active");
  document.getElementById("ptitle").textContent=PAGES[id].t;
  document.getElementById("psub").textContent=PAGES[id].s;
}

// ─── THEME ───
function toggleTheme(){
  const b=document.body;b.classList.toggle("light");
  document.querySelector(".icon-btn").textContent=b.classList.contains("light")?"🌙":"☀️";
}

// ─── CLOCK ───
(function tick(){
  const n=new Date();
  document.getElementById("clock").textContent=
    n.toLocaleDateString("es-CL",{weekday:"short",day:"2-digit",month:"short",year:"numeric"})
    +" · "+n.toLocaleTimeString("es-CL");
  setTimeout(tick,1000);
})();

// ─── TASKS ───
let TASKS=[
  {id:1,name:"Rotar API Key DeepSeek",pri:"alta",done:false,date:"2026-05-04",
    log:[
      {t:"2026-05-04 00:00",ic:"🔴",tx:"API key potencialmente comprometida. Prioridad máxima."},
      {t:"2026-05-04 08:00",ic:"ℹ️",tx:"URL: <span class=\"mono\">platform.deepseek.com</span> → API Keys → Regenerate. Actualizar en <span class=\"mono\">openclaw.json</span> y <span class=\"mono\">~/.env.secrets</span>."}
    ]},
  {id:2,name:"Revocar token Telegram @Valy_bot",pri:"alta",done:false,date:"2026-05-04",
    log:[
      {t:"2026-05-04 00:00",ic:"🔴",tx:"Token de bot expuesto. Debe revocarse en @BotFather."},
      {t:"2026-05-04 08:00",ic:"ℹ️",tx:"Pasos: <span class=\"mono\">/mybots → Valy_bot → API Token → Revoke</span>. Luego actualizar openclaw.json."}
    ]},
  {id:3,name:"Implementar .env.secrets (chmod 600)",pri:"alta",done:false,date:"2026-05-04",
    log:[
      {t:"2026-05-04 08:00",ic:"📋",tx:"Crear <span class=\"mono\">/home/valy/.env.secrets</span> con todas las keys."},
      {t:"2026-05-04 08:00",ic:"ℹ️",tx:"Comando: <span class=\"mono\">touch ~/.env.secrets && chmod 600 ~/.env.secrets</span>"}
    ]},
  {id:4,name:"Instalar Tailscale VPN",pri:"media",done:false,date:"2026-05-04",
    log:[
      {t:"2026-05-04 08:00",ic:"📋",tx:"Instalar en pc.valy, iPad y ZBook. Habilita SSH desde cualquier red (faena, viajes)."},
      {t:"2026-05-04 09:00",ic:"ℹ️",tx:"Doc: <span class=\"mono\">tailscale.com/download/linux</span>. Crear cuenta y vincular dispositivos."}
    ]},
  {id:5,name:"Instalar Ollama (llama3.2:3b)",pri:"media",done:false,date:"2026-05-04",
    log:[
      {t:"2026-05-04 08:00",ic:"📋",tx:"Modelo local para operar sin consumo de API keys. RAM 3.7GB → usar llama3.2:3b o 1b."},
      {t:"2026-05-04 09:00",ic:"ℹ️",tx:"<span class=\"mono\">curl -fsSL https://ollama.ai/install.sh | sh</span> → <span class=\"mono\">ollama pull llama3.2:3b</span>"}
    ]},
  {id:6,name:"Instalar OpenCode.ai",pri:"media",done:false,date:"2026-05-04",
    log:[
      {t:"2026-05-04 08:00",ic:"📋",tx:"Agente de coding IA para tareas de desarrollo en pc.valy."},
    ]},
  {id:7,name:"Configurar modelo fallback Valy",pri:"media",done:false,date:"2026-05-04",
    log:[
      {t:"2026-05-04 08:00",ic:"📋",tx:"Cuando DeepSeek esté lento, Valy debe hacer fallback automático. Candidatos: Gemini 2.5 · Qwen 32b."},
    ]},
  {id:8,name:"Activar skills automáticas",pri:"media",done:false,date:"2026-05-04",
    log:[
      {t:"2026-05-04 08:00",ic:"📋",tx:"Inbox reader listo. Activar skills automáticas en el agente Valy."},
    ]},
  {id:9,name:"Activar notificaciones / alertas automáticas",pri:"baja",done:false,date:"2026-05-04",
    log:[
      {t:"2026-05-04 08:00",ic:"📋",tx:"Configurar alertas automáticas vía Telegram para eventos del sistema y tareas programadas."},
    ]},
  {id:10,name:"Instalar Node.js 24 en pc.valy",pri:"baja",done:false,date:"2026-05-04",
    log:[
      {t:"2026-05-04 08:00",ic:"📋",tx:"Prerrequisito para Claude Code y otros tools npm. Usar nvm o NodeSource."},
    ]},
];

function renderTasks(){
  const c=document.getElementById("taskList");c.innerHTML="";
  const pend=TASKS.filter(t=>!t.done).length;
  document.getElementById("nb-tasks").textContent=pend;
  document.getElementById("kpi-tasks").textContent=pend;
  TASKS.forEach(t=>{
    const b=document.createElement("div");b.className="task-block";
    const pc=t.pri==="alta"?"p-alta":t.pri==="media"?"p-media":"p-baja";
    const pl=t.pri==="alta"?"🔴 Alta":t.pri==="media"?"🟡 Media":"🟢 Baja";
    const logs=t.log.map(l=>`<div class="log-e"><div class="log-t">${l.t}</div><div class="log-ico">${l.ic}</div><div class="log-txt">${l.tx}</div></div>`).join("");
    b.innerHTML=`
      <div class="task-item" onclick="toggleBit(${t.id})">
        <input type="checkbox" class="task-check" ${t.done?"checked":""} onclick="event.stopPropagation();toggleDone(${t.id})"/>
        <div class="task-main">
          <div class="task-name ${t.done?"done-txt":""}">${t.name}</div>
          <div class="task-meta">
            <span class="pri ${pc}">${pl}</span>
            <span class="task-date">📅 ${t.date}</span>
            <span class="task-date">📝 ${t.log.length} entr.</span>
          </div>
        </div>
        <div class="exp-btn" id="eb${t.id}">▾</div>
      </div>
      <div class="bitacora" id="bit${t.id}">
        <div class="bit-head">📓 Bitácora · ${t.name}</div>
        ${logs}
        <div class="bit-add">
          <input class="inp" type="text" id="li${t.id}" placeholder="Agregar entrada..." style="font-size:.73rem;padding:6px 11px;" onkeydown="if(event.key==='Enter')addLog(${t.id})"/>
          <button class="btn btn-sm btn-ghost" onclick="addLog(${t.id})">+ Log</button>
        </div>
      </div>`;
    c.appendChild(b);
  });
}
function toggleBit(id){
  const b=document.getElementById("bit"+id),e=document.getElementById("eb"+id);
  const o=b.classList.toggle("open");e.classList.toggle("open",o);
}
function toggleDone(id){
  const t=TASKS.find(x=>x.id===id);if(!t)return;
  t.done=!t.done;
  const now=new Date().toLocaleString("es-CL",{year:"numeric",month:"2-digit",day:"2-digit",hour:"2-digit",minute:"2-digit"}).replace(","," ");
  t.log.push({t:now,ic:t.done?"✅":"↩️",tx:t.done?"Tarea marcada como completada.":"Tarea reabierta."});
  renderTasks();
}
function addTask(){
  const i=document.getElementById("newTask"),s=document.getElementById("newPri");
  const n=i.value.trim();if(!n)return;
  const now=new Date().toISOString().slice(0,10);
  TASKS.unshift({id:Date.now(),name:n,pri:s.value,done:false,date:now,log:[{t:now+" 00:00",ic:"➕",tx:"Tarea creada desde el dashboard."}]});
  i.value="";renderTasks();
}
function addLog(id){
  const i=document.getElementById("li"+id);const tx=i.value.trim();if(!tx)return;
  const t=TASKS.find(x=>x.id===id);if(!t)return;
  const now=new Date().toLocaleString("es-CL",{year:"numeric",month:"2-digit",day:"2-digit",hour:"2-digit",minute:"2-digit"}).replace(","," ");
  t.log.push({t:now,ic:"📝",tx});i.value="";renderTasks();
  setTimeout(()=>{const b=document.getElementById("bit"+id),e=document.getElementById("eb"+id);if(b&&!b.classList.contains("open")){b.classList.add("open");e.classList.add("open");}},40);
}

// ─── PROJECTS ───
let PROJS=[
  {name:"pc.valy · Infraestructura IA",desc:"Servidor personal HP 820 con OpenClaw, Telegram bot y acceso remoto. Expansión con Tailscale, Ollama y Claude Code.",status:"progress"},
  {name:"Agente Ranger",desc:"Agente explorador de modelos free. Groq llama-3.3-70b como principal con fallbacks Gemini 2.5, Qwen 32b y Compound.",status:"progress"},
  {name:"Documentos Ambientales IA",desc:"Sistema de consulta de PDFs por subproyectos. RAG sobre documentación. Agente Valy como motor de consulta.",status:"plan"},
  {name:"Integración Google Suite",desc:"Maton.ai conectado con Gmail, Calendar, Drive y Docs. Gestión de documentos y eventos vía agente.",status:"done"},
  {name:"Integración Gemini API",desc:"Gemini 2.5 Flash configurado en fallbacks de Ranger. Tier gratuito activo.",status:"done"},
];
const SLBL={done:"✓ Completado",progress:"▶ En Curso",plan:"◎ Planificación"};
const SCLS={done:"b-ok",progress:"b-info",plan:"b-pend"};
function renderProjs(){
  const g=document.getElementById("projGrid");g.innerHTML="";
  PROJS.forEach((p,i)=>{
    const d=document.createElement("div");
    d.className="proj-card "+p.status;
    d.innerHTML=`<div class="proj-name">${p.name}</div><div class="proj-desc">${p.desc}</div>
      <div class="proj-foot">
        <span class="badge ${SCLS[p.status]}">${SLBL[p.status]}</span>
        <button class="del-proj" onclick="delProj(${i})">✕</button>
      </div>`;
    g.appendChild(d);
  });
}
function delProj(i){PROJS.splice(i,1);renderProjs();}
function addProject(){
  const n=document.getElementById("pName").value.trim();
  const d=document.getElementById("pDesc").value.trim();
  const s=document.getElementById("pStatus").value;
  if(!n)return;
  PROJS.unshift({name:n,desc:d||"Sin descripción.",status:s});
  document.getElementById("pName").value="";
  document.getElementById("pDesc").value="";
  renderProjs();
}

// ─── API DATA ───
function saveApiData(){
  const b=document.getElementById("ef-balance").value.trim();
  const m=document.getElementById("ef-monthly").value.trim();
  const tk=document.getElementById("ef-tokens").value.trim();
  const rq=document.getElementById("ef-requests").value.trim();
  if(b){document.getElementById("d-balance").innerHTML=b+' <span style="font-size:.9rem;color:var(--muted);">USD</span>';}
  if(m){document.getElementById("d-monthly").innerHTML=m+' <span style="font-size:.9rem;color:var(--muted);">USD</span>';}
  if(tk){document.getElementById("d-tokens").textContent=tk;}
  if(rq){document.getElementById("d-requests").textContent=rq;}
  document.getElementById("editForm").style.display="none";
}

// ─── INIT ───
renderTasks();
renderProjs();
</script>
</body>
</html>