              <tr><td>EFI timeout</td><td>1s (efibootmgr)</td></tr>
            </table>
          </div>
        </div>
        <div class="card">
          <div class="ch"><div class="ct">🖥️ ZBook Power · Trabajo</div><span class="badge b-ok">Operativo</span></div>
          <div class="cb">
