      <div class="card mb14">
        <div class="ch"><div class="ct">⚠️ Advertencias Críticas</div></div>
        <div class="cb">
          <div class="sys-row">
            <div class="si" style="border-color:rgba(255,85,117,.25);background:rgba(255,85,117,.04);">
              <span class="si-icon">🚫</span><span class="si-lbl" style="color:var(--red);">fbx64.efi</span>
              <span class="si-val" style="color:var(--txt);">Renombrado a .bak · NO restaurar (loop de arranque)</span>
            </div>
            <div class="si" style="border-color:rgba(255,85,117,.25);background:rgba(255,85,117,.04);">
              <span class="si-icon">🚫</span><span class="si-lbl" style="color:var(--red);">BIOS Boot Mode</span>
              <span class="si-val" style="color:var(--txt);">UEFI Hybrid (With CSM) · NO cambiar</span>
            </div>
            <div class="si" style="border-color:rgba(255,85,117,.25);background:rgba(255,85,117,.04);">
              <span class="si-icon">🚫</span><span class="si-lbl" style="color:var(--red);">OpenClaw</span>
              <span class="si-val" style="color:var(--txt);">Siempre iniciar dentro de tmux para persistir sesión</span>
